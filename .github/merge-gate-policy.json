{
  "schema_version": 7,
  "ruleset": {
    "id": 19905142,
    "name": "Protect main"
  },
  "workflow_defaults": [
    {
      "pattern": ".github/workflows/pr-ci.yml",
      "classification": "advisory"
    },
    {
      "pattern": ".github/workflows/ci.yml",
      "classification": "advisory"
    },
    {
      "pattern": ".github/workflows/evidence.yml",
      "classification": "advisory"
    },
    {
      "pattern": ".github/workflows/dependency-review.yml",
      "classification": "advisory"
    },
    {
      "pattern": ".github/workflows/codeql.yml",
      "classification": "advisory"
    },
    {
      "pattern": ".github/workflows/supply-chain.yml",
      "classification": "advisory"
    },
    {
      "pattern": ".github/workflows/campaign-orchestrator.yml",
      "classification": "advisory"
    },
    {
      "pattern": ".github/workflows/m5-*.yml",
      "classification": "advisory"
    },
    {
      "pattern": ".github/workflows/m6-*.yml",
      "classification": "advisory"
    },
    {
      "pattern": ".github/workflows/pr-labeler.yml",
      "classification": "advisory"
    }
  ],
  "job_overrides": [
    {
      "workflow": ".github/workflows/pr-ci.yml",
      "job": "pr-proof",
      "classification": "required"
    },
    {
      "workflow": ".github/workflows/m5-conformance.yml",
      "job": "conformance-campaign",
      "classification": "required"
    }
  ],
  "managed_required_contexts": [],
  "aggregate_gates": [],
  "pending_ruleset_contexts": [],
  "pr_scope": {
    "docs_only": {
      "exact_paths": [
        "README.md",
        "AGENTS.md",
        "CHANGELOG.md",
        "CODE_OF_CONDUCT.md",
        "CONTRIBUTING.md",
        "SECURITY.md"
      ],
      "markdown_prefixes": [
        "docs/"
      ],
      "excluded_prefixes": []
    },
    "campaign_semantics_glob": "tests/fixtures/**/campaign-semantics.json",
    "retained_evidence_policy": "docs/engineering/retained-evidence-policy.json",
    "global_campaign_paths": [
      "Cargo.lock"
    ],
    "trusted_tree_contract": "exact-git-base-sha",
    "global_direct_proof_paths": [
      ".github/scripts/pr-scope.py",
      ".github/merge-gate-policy.json",
      ".github/workflows/campaign-orchestrator.yml",
      "docs/engineering/retained-evidence-policy.json"
    ],
    "docs_only_applicability": {
      "supply_chain": {
        "sensitive_exact_paths": [
          "docs/engineering/dependency-policy.md"
        ],
        "sensitive_prefixes": []
      },
      "evidence_provenance": {
        "sensitive_exact_paths": [],
        "sensitive_prefixes": [
          "docs/engineering/campaigns/"
        ]
      }
    }
  },
  "post_main": {
    "default_branch": "main",
    "allowed_push_workflows": []
  },
  "repository_merge_gate": {
    "context": "merge-gate",
    "state": "active",
    "producer": {
      "workflow": ".github/workflows/pr-labeler.yml",
      "job": "merge-gate"
    },
    "members": [
      {
        "context": "pr-proof",
        "workflow": ".github/workflows/pr-ci.yml"
      },
      {
        "context": "postgres-15-conformance-campaign",
        "workflow": ".github/workflows/m5-conformance.yml"
      },
      {
        "context": "postgres-18-conformance-campaign",
        "workflow": ".github/workflows/m5-conformance.yml"
      }
    ],
    "protected_workflows": [
      {
        "workflow": ".github/workflows/pr-ci.yml",
        "accepted_blobs": [
          "553c60e9ccaa61308527137d5964f4dc1d2094de"
        ]
      },
      {
        "workflow": ".github/workflows/ci.yml",
        "accepted_blobs": [
          "82705875b20a0ca62ed069b69ab3eea8ac47d4cb"
        ]
      },
      {
        "workflow": ".github/workflows/dependency-review.yml",
        "accepted_blobs": [
          "631bf08c7be9704b633cb4d0210db10fba832fec"
        ]
      },
      {
        "workflow": ".github/workflows/codeql.yml",
        "accepted_blobs": [
          "6b9df4e63ffd3ca2c696c1e300b7f7e1cf659639"
        ]
      },
      {
        "workflow": ".github/workflows/evidence.yml",
        "accepted_blobs": [
          "122e3b9671bbbbb69d77011c52b323e028e2fbb1"
        ]
      },
      {
        "workflow": ".github/workflows/supply-chain.yml",
        "accepted_blobs": [
          "f3ffe4aaf4cab64a315fe94f67a8498e9b6509ad"
        ]
      },
      {
        "workflow": ".github/workflows/m5-conformance.yml",
        "accepted_blobs": [
          "5e8c3cba0ae1c9f3d7c454c5a6004e71ad58c0ae"
        ]
      },
      {
        "workflow": ".github/workflows/pr-labeler.yml",
        "accepted_blobs": [
          "a0ddc26dd84e4cf99e2b6b50addedf6e4e86aeb8"
        ]
      }
    ]
  },
  "pr_topology": {
    "schema": "single-pr-entrypoint-v1",
    "entrypoint": ".github/workflows/pr-ci.yml",
    "migration_marker": ".github/ci-topology-v7-migration",
    "reusable_authorities": [
      ".github/workflows/ci.yml",
      ".github/workflows/dependency-review.yml",
      ".github/workflows/codeql.yml",
      ".github/workflows/evidence.yml",
      ".github/workflows/supply-chain.yml",
      ".github/workflows/campaign-orchestrator.yml"
    ],
    "independent_pr_authorities": [
      {
        "workflow": ".github/workflows/m5-conformance.yml",
        "reason": "retained-evidence-provenance",
        "contexts": [
          "postgres-15-conformance-campaign",
          "postgres-18-conformance-campaign"
        ]
      }
    ]
  },
  "internal_aggregates": [
    {
      "context": "postgresql",
      "producer": {
        "workflow": ".github/workflows/ci.yml",
        "job": "postgresql-merge-gate"
      },
      "members": [
        "postgres-15-design-gate",
        "postgres-15-item-components",
        "postgres-15-repository",
        "postgres-16-design-gate",
        "postgres-17-design-gate",
        "postgres-18-design-gate",
        "postgres-18-item-components",
        "postgres-18-repository"
      ]
    }
  ]
}
