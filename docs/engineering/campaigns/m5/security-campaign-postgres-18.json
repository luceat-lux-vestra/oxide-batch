      "fixture": "postgres-security-tls",
      "id": "verify-full-tls",
      "name": "verify_full_tls_is_required_in_the_supported_mode",
      "observation": {
        "attempts": [
          {
            "authority": "signing",
            "expected": "connects",
            "id": "trusted-authority-and-name",
            "intent": "the supported production configuration against a server whose certificate the given authority signed for the name connected to",
            "observed": {
              "encrypted_sessions": 1,
              "plaintext_sessions": 0,
              "result": "connected",
              "transport": [
                "TLSv1.3"
              ]
            }
          },
          {
            "authority": "unrelated",
            "expected": "refused: untrusted-authority",
            "id": "untrusted-authority",
            "intent": "the same server and the same name, trusting an authority that signed nothing it presents",
            "observed": {
              "failure_class": "untrusted-authority",
              "plaintext_sessions": 0,
              "repository_error": "unavailable",
              "result": "refused"
            }
          },
          {
            "authority": "signing",
            "expected": "refused: hostname-mismatch",
            "id": "hostname-mismatch",
            "intent": "the same server and the signing authority, reached under a name its certificate does not carry",
            "observed": {
              "failure_class": "hostname-mismatch",
              "plaintext_sessions": 0,
              "repository_error": "unavailable",
              "result": "refused"
            }
          },
          {
            "authority": "signing",
            "expected": "refused: tls-not-offered",
            "id": "server-without-tls",
            "intent": "a reachable server that offers no TLS, which the supported mode must refuse rather than continue without encryption",
            "observed": {
              "failure_class": "tls-not-offered",
              "plaintext_sessions": 0,
              "repository_error": "unavailable",
              "result": "refused"
            }
          }
        ],
        "certificate_validation_result": "refused",
        "fixture": "postgres-security-tls",
        "hostname_validation_result": "refused",
        "passed": true,
        "plaintext_fallback_result": "refused",
        "postgres_major_version": "18",
        "report": "verify-full TLS in the supported mode",
        "residual_sessions_encrypted": 0,
