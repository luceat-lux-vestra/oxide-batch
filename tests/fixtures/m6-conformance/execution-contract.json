{
  "document": "How CI executes and merges the sharded M6 full component conformance campaign",
  "workflow_path": ".github/workflows/m6-conformance.yml",
  "workflow_name": "M6 Full Component Conformance",
  "runner": "ubuntu-24.04",
  "script": "./tests/fixtures/m6-conformance/run-ci-campaign.sh \"$SHARD_INDEX\" 2",
  "script_path": "tests/fixtures/m6-conformance/run-ci-campaign.sh",
  "command": [
    "cargo",
    "run",
    "--package",
    "oxide-batch-xtask",
    "--",
    "m6-conformance"
  ],
  "cargo_profile": "debug",
  "environment": {
    "OXIDEBATCH_CAMPAIGN_DIR": "target/m6-campaigns",
    "OXIDEBATCH_CAMPAIGN_MATRIX": "postgres-${{ matrix.postgres }}",
    "OXIDEBATCH_POSTGRES_ADMIN_TEST_URL": "postgres://postgres:postgres@127.0.0.1:5432/oxide_batch_m6_conformance",
    "OXIDEBATCH_POSTGRES_MIGRATOR_TEST_URL": "postgres://postgres:postgres@127.0.0.1:5432/oxide_batch_m6_conformance",
    "OXIDEBATCH_POSTGRES_TEST_URL": "postgres://postgres:postgres@127.0.0.1:5432/oxide_batch_m6_conformance"
  },
  "report_path": "target/m6-campaigns/m6-conformance-campaign.json",
  "artifact_name": "m6-conformance-campaign-postgres-${{ matrix.postgres }}",
  "timeout_minutes": 40,
  "artifact_retention": "30 days, on success and on failure alike",
  "matrix": [
    "15",
    "18"
  ],
  "workflow_git_blob": "ba724dbedf759e189caeb3a3497d56c52f1b0d0d",
  "triggers": {
    "workflow_call": true,
    "workflow_dispatch": true
  },
  "merge_timeout_minutes": 15,
  "sharding": {
    "count": 2,
    "shard_matrix": [
      0,
      1
    ],
    "shard_index_env": "OXIDEBATCH_M6_CONFORMANCE_SHARD_INDEX",
    "shard_count_env": "OXIDEBATCH_M6_CONFORMANCE_SHARD_COUNT",
    "merge_dir_env": "OXIDEBATCH_M6_CONFORMANCE_MERGE_DIR",
    "partial_report_path": "target/m6-campaigns/m6-conformance-shard-${{ matrix.shard }}.json",
    "partial_artifact_name": "m6-conformance-shard-postgres-${{ matrix.postgres }}-${{ matrix.shard }}",
    "merge_script": "./tests/fixtures/m6-conformance/merge-ci-campaign.sh",
    "merge_script_path": "tests/fixtures/m6-conformance/merge-ci-campaign.sh",
    "merge_input_dir": "target/m6-conformance-shards",
    "canonical_job_name": "postgres-${{ matrix.postgres }}-m6-conformance"
  }
}
